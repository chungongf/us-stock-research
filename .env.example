# Pick one provider. If LLM_PROVIDER is empty, OpenAI is used when OPENAI_API_KEY is set, otherwise Anthropic.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Required by SEC EDGAR: an app name and a contact email.
SEC_USER_AGENT=USStockResearch you@example.com

# Recommended on a public URL: protects the app with a login (username: anything, password: this).
APP_PASSWORD=

MAX_CONCURRENT_JOBS=1
